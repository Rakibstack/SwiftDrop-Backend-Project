
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Your SwiftDrop Rider Application Has Been Approved</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
        box-sizing: border-box;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
      }

      .header {
        padding: 28px 35px;
        background-color: #111827;
        text-align: center;
      }

      .brand {
        margin: 0;
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
      }

      .content {
        padding: 38px 35px;
      }

      .title {
        margin: 0 0 18px;
        font-size: 24px;
        font-weight: 700;
        color: #111827;
      }

      .text {
        margin: 0 0 18px;
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
      }

      .success-box {
        margin: 28px 0;
        padding: 20px;
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 10px;
        text-align: center;
      }

      .success-title {
        margin: 0 0 8px;
        font-size: 18px;
        font-weight: 700;
        color: #166534;
      }

      .success-text {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: #15803d;
      }

      .next-step {
        margin: 25px 0;
        padding: 18px;
        background-color: #f9fafb;
        border-radius: 8px;
      }

      .next-step p {
        margin: 0 0 8px;
        font-size: 14px;
        line-height: 1.6;
        color: #4b5563;
      }

      .next-step p:last-child {
        margin-bottom: 0;
      }

      .footer {
        padding: 22px 35px;
        background-color: #f9fafb;
        text-align: center;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        margin: 4px 0;
        font-size: 12px;
        color: #9ca3af;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 30px 22px;
        }

        .header {
          padding: 24px 20px;
        }

        .footer {
          padding: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">

        <div class="header">
          <h1 class="brand">SwiftDrop</h1>
        </div>

        <div class="content">
          <h2 class="title">
            Congratulations, <%= name %>!
          </h2>

          <p class="text">
            We are pleased to inform you that your application to become a
            SwiftDrop rider has been reviewed and approved.
          </p>

          <div class="success-box">
            <p class="success-title">
              Rider Application Approved
            </p>

            <p class="success-text">
              Your rider account has been approved and you can now continue
              with the account setup process.
            </p>
          </div>

          <div class="next-step">
            <p>
              <strong>What happens next?</strong>
            </p>

            <p>
              Your account credentials will be provided separately.
              For security reasons, please change your temporary password
              after your first login.
            </p>
          </div>

          <p class="text">
            Welcome to the SwiftDrop rider community. We look forward to
            working with you.
          </p>

          <p class="text">
            Best regards,<br />
            <strong>SwiftDrop Team</strong>
          </p>
        </div>

        <div class="footer">
          <p>© <%= new Date().getFullYear() %> SwiftDrop</p>
          <p>Merchant-Focused Courier & Last-Mile Logistics Platform</p>
        </div>

      </div>
    </div>
  </body>
</html>