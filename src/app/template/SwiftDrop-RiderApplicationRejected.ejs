
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Your SwiftDrop Rider Application Update</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
        box-sizing: border-box;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
      }

      .header {
        padding: 28px 35px;
        background-color: #111827;
        text-align: center;
      }

      .brand {
        margin: 0;
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
      }

      .content {
        padding: 38px 35px;
      }

      .title {
        margin: 0 0 18px;
        font-size: 24px;
        font-weight: 700;
        color: #111827;
      }

      .text {
        margin: 0 0 18px;
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
      }

      .notice-box {
        margin: 28px 0;
        padding: 20px;
        background-color: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 10px;
      }

      .notice-title {
        margin: 0 0 10px;
        font-size: 17px;
        font-weight: 700;
        color: #9a3412;
      }

      .notice-text {
        margin: 0;
        font-size: 14px;
        line-height: 1.7;
        color: #7c2d12;
      }

      .reason-box {
        margin: 20px 0 28px;
        padding: 18px;
        background-color: #f9fafb;
        border-left: 4px solid #f97316;
        border-radius: 6px;
      }

      .reason-label {
        margin: 0 0 8px;
        font-size: 13px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .reason {
        margin: 0;
        font-size: 14px;
        line-height: 1.7;
        color: #374151;
      }

      .footer {
        padding: 22px 35px;
        background-color: #f9fafb;
        text-align: center;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        margin: 4px 0;
        font-size: 12px;
        color: #9ca3af;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 30px 22px;
        }

        .header {
          padding: 24px 20px;
        }

        .footer {
          padding: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">

        <div class="header">
          <h1 class="brand">SwiftDrop</h1>
        </div>

        <div class="content">
          <h2 class="title">
            Rider Application Update
          </h2>

          <p class="text">
            Hello <%= name %>,
          </p>

          <p class="text">
            Thank you for your interest in becoming a SwiftDrop rider.
            After reviewing your application, we are unable to approve
            your application at this time.
          </p>

          <div class="notice-box">
            <p class="notice-title">
              Application Not Approved
            </p>

            <p class="notice-text">
              Your rider application has been rejected based on the
              information provided during the application process.
            </p>
          </div>

          <div class="reason-box">
            <p class="reason-label">
              Reason for Rejection
            </p>

            <p class="reason">
              <%= rejectionReason %>
            </p>
          </div>

          <p class="text">
            Please review the information above and follow any applicable
            instructions before submitting another application.
          </p>

          <p class="text">
            Best regards,<br />
            <strong>SwiftDrop Team</strong>
          </p>
        </div>

        <div class="footer">
          <p>© <%= new Date().getFullYear() %> SwiftDrop</p>
          <p>Merchant-Focused Courier & Last-Mile Logistics Platform</p>
        </div>

      </div>
    </div>
  </body>
</html>