
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>Welcome to SwiftDrop</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f4f7fb;
  font-family: Arial, Helvetica, sans-serif;
  color: #1f2937;
">

  <table
    role="presentation"
    width="100%"
    cellspacing="0"
    cellpadding="0"
    border="0"
    style="
      width: 100%;
      background-color: #f4f7fb;
      padding: 40px 16px;
    "
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          role="presentation"
          width="100%"
          cellspacing="0"
          cellpadding="0"
          border="0"
          style="
            max-width: 560px;
            background-color: #ffffff;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid #e5e7eb;
          "
        >

          <!-- Header -->
          <tr>
            <td
              style="
                padding: 28px 32px;
                border-bottom: 1px solid #eef2f7;
              "
            >

              <div style="
                font-size: 24px;
                font-weight: 700;
                color: #111827;
              ">
                Swift<span style="color: #2563eb;">Drop</span>
              </div>

              <div style="
                margin-top: 6px;
                font-size: 12px;
                color: #64748b;
              ">
                Merchant-Focused Courier & Logistics Platform
              </div>

            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px 32px 36px;">

              <p style="
                margin: 0 0 10px;
                font-size: 15px;
                color: #64748b;
              ">
                Hello <strong><%= name %></strong>,
              </p>

              <h1 style="
                margin: 0 0 18px;
                font-size: 28px;
                line-height: 1.3;
                color: #111827;
              ">
                Welcome to SwiftDrop!
              </h1>

              <p style="
                margin: 0 0 18px;
                font-size: 15px;
                line-height: 1.7;
                color: #64748b;
              ">
                Your merchant account has been successfully created.
                You can now use SwiftDrop to manage your deliveries
                and keep track of your shipments from one place.
              </p>

              <!-- Highlight -->
              <table
                role="presentation"
                width="100%"
                cellspacing="0"
                cellpadding="0"
                border="0"
                style="
                  margin: 28px 0;
                  background-color: #eff6ff;
                  border: 1px solid #dbeafe;
                  border-radius: 10px;
                "
              >
                <tr>
                  <td style="padding: 20px;">

                    <p style="
                      margin: 0 0 8px;
                      font-size: 14px;
                      font-weight: 700;
                      color: #1d4ed8;
                    ">
                      Your SwiftDrop journey starts here
                    </p>

                    <p style="
                      margin: 0;
                      font-size: 13px;
                      line-height: 1.7;
                      color: #475569;
                    ">
                      Create shipments, arrange deliveries, track
                      parcel status, and manage your courier
                      operations with SwiftDrop.
                    </p>

                  </td>
                </tr>
              </table>

              <p style="
                margin: 0;
                font-size: 15px;
                line-height: 1.7;
                color: #64748b;
              ">
                We're glad to have you with us and look forward to
                helping you deliver better.
              </p>

              <p style="
                margin: 28px 0 0;
                font-size: 15px;
                line-height: 1.7;
                color: #1f2937;
              ">
                Best regards,<br>
                <strong>The SwiftDrop Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="
              padding: 24px 32px;
              background-color: #f8fafc;
              border-top: 1px solid #eef2f7;
            ">

              <p style="
                margin: 0 0 8px;
                font-size: 12px;
                line-height: 1.6;
                color: #64748b;
              ">
                This is an automated message from SwiftDrop.
                Please do not reply to this email.
              </p>

              <p style="
                margin: 0;
                font-size: 12px;
                color: #94a3b8;
              ">
                &copy; SwiftDrop. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

        <p style="
          margin: 20px 0 0;
          font-size: 11px;
          color: #94a3b8;
          text-align: center;
        ">
          Secure delivery. Smarter logistics.
        </p>

      </td>
    </tr>
  </table>

</body>
</html>