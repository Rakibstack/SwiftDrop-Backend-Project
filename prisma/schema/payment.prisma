model Payment {
    id String @id @default(uuid())

    status PaymentStatus @default(UNPAID)

    currency String @default("BDT")
    amount Decimal @db.Decimal(10, 2)

    paymentGateway String @default("BKASH")

    merchantInvoiceNumber String @unique
    bkashPaymentId String? @unique
    bkashTrxId     String? @unique
    payerReference String?

    paidAt DateTime?

    gatewayResponse Json?

    refundTrxId  String?
    refundAmount Decimal?  @db.Decimal(10, 2)
    refundReason String?
    refundAt     DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    shipmentId String
    shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([shipmentId])
    @@index([status])
    @@map("payments")
}
